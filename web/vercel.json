{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/device/bank.js": {
      "maxDuration": 30,
      "includeFiles": "{data/bank.mcq.json,js/progress-merge.js}"
    },
    "api/device/*.js": {
      "maxDuration": 30,
      "includeFiles": "js/progress-merge.js"
    },
    "api/progress.js": {
      "maxDuration": 30,
      "includeFiles": "js/progress-merge.js"
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/play", "destination": "/play.html" },
    { "source": "/play/", "destination": "/play.html" }
  ]
}