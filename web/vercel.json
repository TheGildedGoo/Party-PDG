{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    },
    "api/device/bank.js": {
      "maxDuration": 30,
      "includeFiles": "data/bank.mcq.json"
    }
  },
  "rewrites": [
    { "source": "/play", "destination": "/play.html" },
    { "source": "/play/", "destination": "/play.html" }
  ]
}
