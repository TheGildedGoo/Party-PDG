{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdg-party-relay",
  "account_id": "e478540f37fca53f5446ad81ab788746",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://pdg-play.com,https://www.pdg-play.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }
  ],
  "ratelimits": [
    {
      "name": "JOIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
